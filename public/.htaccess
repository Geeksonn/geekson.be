RewriteEngine On

# Always serve https://www.geekson.be
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.geekson.be/$1 [R=301,L]

# Home page: send visitors to their browser language, French by default
RewriteCond %{HTTP:Accept-Language} ^nl [NC]
RewriteRule ^$ /nl/ [R=302,L]
RewriteCond %{HTTP:Accept-Language} ^en [NC]
RewriteRule ^$ /en/ [R=302,L]
RewriteRule ^$ /fr/ [R=302,L]

<IfModule mod_headers.c>
    Header append Vary Accept-Language
</IfModule>

ErrorDocument 404 /404.html
